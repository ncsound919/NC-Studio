<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Debug builds only, and still narrow: cleartext is limited to loopback,
        the emulator host and `.local` names. A session server on a laptop
        should use TLS; trusting user-installed CAs here lets a phone accept
        the laptop's own certificate without touching the release config.

        An address like 192.168.1.20 cannot be listed here: this format has no
        CIDR ranges and matches hostnames by suffix, not address prefix. Wi-Fi
        model servers go through LocalHttpTransport instead, which refuses any
        destination that is not loopback, link-local or RFC 1918 before it
        connects.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>