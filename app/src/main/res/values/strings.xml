    <!-- Onboarding tour and release notes -->
    <string name="onboarding_record_title">Record</string>
    <string name="onboarding_record_body">Arm a track, hit record, and punch in only where you need a take.</string>
    <string name="onboarding_import_title">Import</string>
    <string name="onboarding_import_body">Bring in WAV, MP3, FLAC, or M4A stems and place them on any track.</string>
    <string name="onboarding_mix_title">Mix</string>
    <string name="onboarding_mix_body">Balance, pan, EQ, and compress. AI suggestions stay deterministic and bounded.</string>
    <string name="onboarding_export_title">Export</string>
    <string name="onboarding_export_body">Render a master or individual stems, then share or save to your chosen folder.</string>
    <string name="release_rack_title">Studio plugin rack</string>
    <string name="release_rack_body">Add ordered EQ, dynamics, color and space modules per track, route tracks to group buses, and save the chain with the project.</string>
    <string name="release_ncbeat_title">NC Beat import</string>
    <string name="release_ncbeat_body">Import an .ncbeat package and its tempo, sections and stems land on the timeline as editable clips.</string>
    <string name="release_reference_title">Reference A/B</string>
    <string name="release_reference_body">Load a commercial mix, measure it against yours, and audition both level-matched. Suggested moves stay bounded and undoable.</string>
    <string name="release_project_title">Project lifecycle</string>
    <string name="release_project_body">New, Open, Save and Save As are in the top-bar menu. Auto-save writes a recovery snapshot on your chosen interval.</string>
    <string name="release_timeline_title">Faster timeline editing</string>
    <string name="release_timeline_body">Long-press drag, multi-select, trim, spot, heal, crossfade and a whole-session overview strip.</string>
    <string name="release_session_title">Remote Session (beta)</string>
    <string name="release_session_body">Record with an engineer over the companion session server, with hash-verified takes. Beta: requires a laptop server and TLS in release builds.</string>
    <string name="release_export_title">Choose where exports go</string>
    <string name="release_export_body">Pick any folder with the system picker. NC Studio remembers it and writes masters and stems there.</string>
    <string name="release_health_title">Know when the engine is struggling</string>
    <string name="release_health_body">Settings summarizes callback headroom, underruns, and UI frame pacing in one health card.</string>

